[sub_resource type="GDScript" id="GDScript_vjb82"]
script/source = "extends CharacterBody2D

@export var default_direction := \"down\"
@export var reset_when_player_leaves := true

@onready var interact_area: Area2D = $Area2D
@onready var prompt: Node2D = $InteractUI

var sprite: AnimatedSprite2D
var player: Node2D
var player_near := false

func _ready() -> void:
	# Finds the NPC's own AnimatedSprite2D, whatever it's named
	sprite = find_children(\"*\", \"AnimatedSprite2D\", false, false)[0]
	_play_idle(default_direction)
	prompt.hide()
	interact_area.body_entered.connect(_on_body_entered)
	interact_area.body_exited.connect(_on_body_exited)

func _on_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"Player\"):
		player = body
		player_near = true
		prompt.show()

func _on_body_exited(body: Node2D) -> void:
	if body.is_in_group(\"Player\"):
		player_near = false
		prompt.hide()
		if reset_when_player_leaves:
			_play_idle(default_direction)

func _unhandled_input(event: InputEvent) -> void:
	if player_near and event.is_action_pressed(\"interact\"):
		face_towards(player.global_position)
		StoryManager.interact_with_npc(\"cak_jon\", \"Cak Jon\")
		get_viewport().set_input_as_handled()

func face_towards(target: Vector2) -> void:
	var diff := target - global_position
	var dir: String
	if abs(diff.x) > abs(diff.y):
		dir = \"right\" if diff.x > 0 else \"left\"
	else:
		dir = \"down\" if diff.y > 0 else \"up\"
	_play_idle(dir)

func _play_idle(dir: String) -> void:
	var anim := \"idle_\" + dir
	if sprite.sprite_frames.has_animation(anim):
		sprite.play(anim)
	else:
		push_warning(\"%s is missing animation: %s\" % [name, anim])
"

