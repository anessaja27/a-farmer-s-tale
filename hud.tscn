[sub_resource type="GDScript" id="GDScript_vjb82"]
script/source = "extends CanvasLayer

@onready var day_label: Label = %DayLabel
@onready var time_label: Label = %TimeLabel

func _ready() -> void:
	TimeManager.time_changed.connect(_refresh)
	_refresh()

func _refresh(_h: int = 0, _m: int = 0) -> void:
	day_label.text = \"Day %d\" % TimeManager.day
	time_label.text = TimeManager.get_time_text()
"

