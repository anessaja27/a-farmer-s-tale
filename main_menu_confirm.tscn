[gd_scene format=3 uid="uid://8riu1v6plhqu"]

[ext_resource type="Texture2D" uid="uid://b3kfl8eg7qrlp" path="res://assets/ui/ui_only/main_menu_confirm.png" id="1_hxrwr"]

[sub_resource type="GDScript" id="GDScript_nwcfo"]
script/source = "extends Control

const main_menu = \"res://main_menu.tscn\"


func _on_main_menu_pressed() -> void:
	get_tree().paused = false

	var current_scene = get_tree().current_scene

	if current_scene.has_method(\"fade_out\"):
		await current_scene.fade_out()

	get_tree().change_scene_to_file(\"res://main_menu.tscn\")


func _on_cancel_pressed() -> void:
	hide()
"

