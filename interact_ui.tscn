[sub_resource type="GDScript" id="GDScript_vjb82"]
script/source = "extends Node2D

@export_enum(\"enter\", \"harvest\", \"open\", \"pick_up\", \"sleep\", \"talk\", \"exit\") var prompt_animation: String = \"enter\"

@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D

func _ready() -> void:
	hide()   # sembunyi sampai player dekat
	visibility_changed.connect(_on_visibility_changed)

func _on_visibility_changed() -> void:
	if visible:
		sprite.play(prompt_animation)
	else:
		sprite.stop()
"

