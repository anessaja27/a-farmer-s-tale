[sub_resource type="GDScript" id="GDScript_p81d2"]
script/source = "extends CanvasLayer

@onready var root: Control = $root
@onready var quit_confirm: Control = $root/QuitConfirmMenu
@onready var main_menu_confirm: Control = $root/MainMenuConfirm


func _ready():
	process_mode = Node.PROCESS_MODE_ALWAYS
	root.hide()
	quit_confirm.hide()
	main_menu_confirm.hide()


func _input(event):
	if event.is_action_pressed(\"ui_cancel\") and not event.is_echo():

		# Close confirmation first if it's open
		if quit_confirm.visible:
			quit_confirm.hide()

		elif main_menu_confirm.visible:
			main_menu_confirm.hide()

		else:
			toggle_pause()

		get_viewport().set_input_as_handled()


func toggle_pause():
	var is_paused = not get_tree().paused

	get_tree().paused = is_paused
	root.visible = is_paused


func resume_game():
	get_tree().paused = false
	root.hide()
	quit_confirm.hide()
	main_menu_confirm.hide()


# Quit Game button
func _on_quit_game_pressed():
	quit_confirm.show()


# YES button
func _on_quit_button_pressed():
	get_tree().quit()


# NO button
func _on_cancel_button_pressed():
	quit_confirm.hide()


func _on_main_menu_pressed() -> void:
	main_menu_confirm.show()
"

