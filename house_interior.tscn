[sub_resource type="GDScript" id="GDScript_a6njh"]
script/source = "extends Node2D

@onready var bed_area: Area2D = %BedArea
@onready var interact_ui: Node2D = bed_area.get_node(\"InteractUI\")
@onready var color_rect: ColorRect = %ColorRect
@onready var player: CharacterBody2D = %Player

var near_bed := false
var is_sleeping := false

func _ready() -> void:
	color_rect.color = Color(0, 0, 0, 1.0)   # mulai hitam penuh
	interact_ui.hide()
	if not bed_area.body_entered.is_connected(_on_bed_area_body_entered):
		bed_area.body_entered.connect(_on_bed_area_body_entered)
	if not bed_area.body_exited.is_connected(_on_bed_area_body_exited):
		bed_area.body_exited.connect(_on_bed_area_body_exited)
	fade_in()

# --- Dipakai oleh door.gd ---
func fade_out() -> void:
	color_rect.mouse_filter = Control.MOUSE_FILTER_STOP
	await _fade_to(1.0, 0.5)

func fade_in() -> void:
	await _fade_to(0.0, 0.5)
	color_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE

func _fade_to(alpha: float, duration: float) -> void:
	var tween := create_tween()
	tween.tween_property(color_rect, \"color:a\", alpha, duration)
	await tween.finished

# --- Kasur ---
func _on_bed_area_body_entered(body: Node2D) -> void:
	print(\"masuk area kasur: \", body.name)
	if body == player and not is_sleeping:
		near_bed = true
		interact_ui.show()

func _on_bed_area_body_exited(body: Node2D) -> void:
	if body == player:
		near_bed = false
		interact_ui.hide()

func _unhandled_input(event: InputEvent) -> void:
	if near_bed and not is_sleeping and event.is_action_pressed(\"interact\"):
		sleep()

func sleep() -> void:
	is_sleeping = true
	interact_ui.hide()
	player.set_physics_process(false)

	await _fade_to(1.0, 1.0)             # layar jadi hitam
	TimeManager.start_next_day()         # ganti hari
	await get_tree().create_timer(1.0).timeout
	await _fade_to(0.0, 1.0)             # layar terang lagi

	player.set_physics_process(true)
	is_sleeping = false
	if near_bed:
		interact_ui.show()
"

